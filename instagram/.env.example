# Copy this file to .env in the same folder and fill in what you use. .env is gitignored: never commit it, and never
# paste a key or token into a chat. The scripts read each value from your environment first, then from .env, and
# never print it.

# Optional. A Gemini API key for the watch pass (what changes on screen, second by second).
# Without it the run skips the watch notes and says so; everything else works. Create one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional, per Instagram account. The per-second retention curve does NOT need these.
# With them the collector finds new Reels by itself and cross-checks views, watch time and skip rate with the official
# API. Without them you name the Reels to track with --reel (once per Reel).
# Name them after the account's alias in capitals, with - written as _. For an account added as "main":
# IG_TOKEN_MAIN=
# IG_USER_ID_MAIN=
# Setting up a token: https://developers.facebook.com/docs/instagram-platform/instagram-api-with-instagram-login/
